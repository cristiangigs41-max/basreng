{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/ai-chat", "destination": "/api/ai-chat" },
    { "source": "/ai-setup", "destination": "/api/ai-setup" },
    { "source": "/maps-resolve", "destination": "/api/maps-resolve" }
  ],
  "functions": { "api/*.js": { "maxDuration": 60 } }
}
